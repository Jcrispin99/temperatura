@page
@using Temperatura.Web.Domain.Enums
@using Temperatura.Web.Services
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="row align-items-center py-5 g-5">
        <div class="col-lg-7">
            <span class="badge rounded-pill text-bg-primary mb-3">Control diario</span>
            <h1 class="display-5 fw-semibold">Registro de temperatura y humedad</h1>
            <p class="lead text-secondary">
                Registra manualmente las mediciones de cada ambiente y supervisa su cumplimiento diario.
            </p>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg px-4">Ingresar</a>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5">Control centralizado</h2>
                    <p class="text-secondary mb-0">
                        Horarios, ventanas de captura y rangos configurables para cada ambiente.
                    </p>
                </div>
            </div>
        </div>
    </div>
}
else if (Model.Ambientes.Count == 0)
{
    <div class="empty py-5">
        <div class="empty-header">Sin ambientes</div>
        <p class="empty-title">No tienes ambientes activos asignados</p>
        <p class="empty-subtitle text-secondary">Solicita al supervisor que revise tu configuración.</p>
    </div>
}
else if (Model.EsSupervisor)
{
    var resumenPeriodo = Model.ResumenPeriodo!;
    var pendientesSinRegularizar = Math.Max(
        resumenPeriodo.RegistrosNoRegistrados - resumenPeriodo.RegistrosFueraDePlazo,
        0);

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <span class="badge text-bg-primary mb-2">Supervisión</span>
            <h1 class="h2 mb-1">Avance de registros</h1>
            <p class="text-secondary mb-0">@Model.FechaDesde.ToString("dd/MM/yyyy") al @Model.FechaHasta.ToString("dd/MM/yyyy")</p>
        </div>
        <a asp-page="/Registros/Nuevo" class="btn btn-primary">Registrar mediciones</a>
    </div>

    <form method="get" class="card border-0 shadow-sm dashboard-filter-card mb-4">
        <div class="card-body p-3 p-lg-4">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label class="form-label">Período</label>
                    <div class="btn-group w-100" role="group" aria-label="Período de consulta">
                        <input type="radio" class="btn-check" name="Periodo" value="Diario" id="periodo-diario" checked="@(Model.Periodo == PeriodoDashboard.Diario)" />
                        <label class="btn btn-outline-primary" for="periodo-diario">Diario</label>
                        <input type="radio" class="btn-check" name="Periodo" value="Semanal" id="periodo-semanal" checked="@(Model.Periodo == PeriodoDashboard.Semanal)" />
                        <label class="btn btn-outline-primary" for="periodo-semanal">Semanal</label>
                        <input type="radio" class="btn-check" name="Periodo" value="Mensual" id="periodo-mensual" checked="@(Model.Periodo == PeriodoDashboard.Mensual)" />
                        <label class="btn btn-outline-primary" for="periodo-mensual">Mensual</label>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label asp-for="Fecha" class="form-label">Fecha de referencia</label>
                    <input asp-for="Fecha" type="date" class="form-control" />
                </div>
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label" for="ambientes">Ambientes</label>
                    <select id="ambientes" name="AmbienteIds" class="form-select" multiple size="1" aria-label="Ambientes a incluir">
                        @foreach (var ambiente in Model.Ambientes)
                        {
                            <option value="@ambiente.Id" selected="@(Model.AmbienteIds?.Contains(ambiente.Id) == true)">@ambiente.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-lg-1 d-grid">
                    <button type="submit" class="btn btn-primary">Aplicar</button>
                </div>
            </div>
        </div>
    </form>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm h-100 dashboard-overview-card">
                <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center">
                    <div class="dashboard-overview-chart">
                        <canvas id="grafica-avance-general"
                                role="img"
                                aria-label="Distribución general: @resumenPeriodo.RegistrosCompletados cumplidos, @resumenPeriodo.RegistrosFueraDePlazo regularizados fuera de plazo y @pendientesSinRegularizar pendientes o sin registro.">
                            Avance general: @resumenPeriodo.PorcentajeAvance.ToString("0.##")%.
                        </canvas>
                    </div>
                    <div class="row g-3 w-100 mt-1 text-center">
                        <div class="col-6 col-sm-3">
                            <div class="text-secondary small">Programados</div>
                            <div class="dashboard-summary-number">@resumenPeriodo.RegistrosEsperados</div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="text-secondary small">Cumplidos</div>
                            <div class="dashboard-summary-number text-success">@resumenPeriodo.RegistrosCompletados</div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="text-secondary small">Pendientes o sin registro</div>
                            <div class="dashboard-summary-number @(pendientesSinRegularizar > 0 ? "text-secondary" : "text-success")">@pendientesSinRegularizar</div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="text-secondary small">Regularizados fuera de plazo</div>
                            <div class="dashboard-summary-number @(resumenPeriodo.RegistrosFueraDePlazo > 0 ? "text-warning" : string.Empty)">@resumenPeriodo.RegistrosFueraDePlazo</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header">
                    <h2 class="card-title">Ambientes</h2>
                </div>
                <div class="list-group list-group-flush dashboard-environment-list">
                    @foreach (var ambiente in resumenPeriodo.Ambientes.OrderBy(x => x.PorcentajeAvance).ThenBy(x => x.Ambiente))
                    {
                        <a asp-page="/Registros/Historial/Index"
                           asp-route-FechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")"
                           asp-route-FechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")"
                           asp-route-AmbienteId="@ambiente.AmbienteId"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
                            <span class="text-truncate">@ambiente.Ambiente</span>
                            <span class="dashboard-percentage">@ambiente.PorcentajeAvance.ToString("0.##")%</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (resumenPeriodo.RegistrosEsperados > 0)
    {
        <section class="row g-4 mt-0" aria-labelledby="graficas-avance-titulo">
            <div class="col-12">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mt-4">
                    <div>
                        <h2 id="graficas-avance-titulo" class="h3 mb-1">Detalle por ambiente</h2>
                        <p class="text-secondary mb-0">Comparación de los registros programados en el período seleccionado.</p>
                    </div>
                    <span class="badge text-bg-light">@resumenPeriodo.AmbientesConsiderados ambientes</span>
                </div>
            </div>

            <div class="col-12">
                <div class="card border-0 shadow-sm h-100 dashboard-chart-card">
                    <div class="card-header">
                        <div>
                            <h3 class="card-title mb-1">Cumplimiento por ambiente</h3>
                            <div class="text-secondary small">Los ambientes con menor avance aparecen primero.</div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="dashboard-chart-container dashboard-chart-bars" data-dashboard-bar-container>
                            <canvas id="grafica-avance-ambientes"
                                    role="img"
                                    aria-label="Barras apiladas del cumplimiento por ambiente.">
                                Consulta la lista de ambientes para conocer el porcentaje de cada uno.
                            </canvas>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    }

    <script id="datos-graficas-avance" type="application/json">@Html.Raw(Model.DatosGraficasAvanceJson)</script>
}
else if (Model.ResumenSeleccionado is { } resumen)
{
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <span class="badge text-bg-primary mb-2">Mi control diario</span>
            <h1 class="h2 mb-1">@resumen.Ambiente</h1>
            <p class="text-secondary mb-0">Día operativo @resumen.FechaOperativa.ToString("dd/MM/yyyy")</p>
        </div>

        @if (Model.Ambientes.Count > 1)
        {
            <form method="get" class="dashboard-environment-selector">
                <label asp-for="AmbienteId" class="form-label">Ambiente</label>
                <select asp-for="AmbienteId" class="form-select" onchange="this.form.submit()">
                    @foreach (var ambiente in Model.Ambientes)
                    {
                        <option value="@ambiente.Id">
                            @ambiente.Nombre@(ambiente.EsPredeterminado ? " (predeterminado)" : string.Empty)
                        </option>
                    }
                </select>
            </form>
        }
        else
        {
            <span class="badge text-bg-light">Ambiente predeterminado</span>
        }
    </div>

    @if (resumen.ProximaVentana is { } proxima)
    {
        <div class="alert @(proxima.Estado == EstadoHorarioDiario.Pendiente ? "alert-success" : "alert-info") d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3" role="status">
            <div>
                <div class="fw-semibold">
                    @(proxima.Estado == EstadoHorarioDiario.Pendiente
                        ? $"El horario {proxima.Horario} está disponible"
                        : $"Próxima apertura: horario {proxima.Horario} a las {proxima.Apertura:HH:mm}")
                </div>
                <div class="small">
                    Ventana: @proxima.Apertura.ToString("dd/MM HH:mm") – @proxima.Cierre.ToString("dd/MM HH:mm")
                </div>
            </div>
            @if (proxima.Estado == EstadoHorarioDiario.Pendiente)
            {
                <a asp-page="/Registros/Nuevo" asp-route-AmbienteId="@resumen.AmbienteId" class="btn btn-success">
                    Registrar ahora
                </a>
            }
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-secondary small">Avance diario</div>
                    <div class="dashboard-metric">@resumen.PorcentajeAvance.ToString("0.##")%</div>
                    <div class="text-secondary">@resumen.RegistrosCompletados de @resumen.RegistrosEsperados registros</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-secondary small">Fuera de plazo</div>
                    <div class="dashboard-metric @(resumen.RegistrosFueraDePlazo > 0 ? "text-danger" : string.Empty)">@resumen.RegistrosFueraDePlazo</div>
                    <div class="text-secondary">No cuentan como cumplimiento</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-secondary small">Cumplimiento al momento</div>
                    <div class="dashboard-metric">@(resumen.PorcentajeCumplimiento?.ToString("0.##") is string actual ? $"{actual}%" : "—")</div>
                    <div class="text-secondary">@resumen.CumplidosExigibles de @resumen.HorariosExigibles exigibles</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-secondary small">Registros tardíos</div>
                    <div class="dashboard-metric @(resumen.RegistrosTardios > 0 ? "text-warning" : string.Empty)">@resumen.RegistrosTardios</div>
                    <div class="text-secondary">Cuentan como completados</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-secondary small">Alertas de rango</div>
                    <div class="dashboard-metric @(resumen.RegistrosFueraDeRango > 0 ? "text-danger" : string.Empty)">@resumen.RegistrosFueraDeRango</div>
                    <div class="text-secondary">Registros con alguna alerta</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header">
                    <h2 class="card-title">Horarios del día</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Horario</th>
                                <th>Ventana</th>
                                <th>Estado</th>
                                <th>Resultado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var horario in resumen.Horarios)
                            {
                                <tr>
                                    <td class="fw-semibold">@horario.Horario</td>
                                    <td class="small">
                                        @horario.Apertura.ToString("dd/MM HH:mm") – @horario.Cierre.ToString("dd/MM HH:mm")
                                    </td>
                                    <td>
                                        <span class="schedule-status schedule-status-@horario.Estado.ToString().ToLowerInvariant()">
                                            @EtiquetaEstado(horario.Estado)
                                        </span>
                                    </td>
                                    <td>
                                        @if (horario.RegistroId.HasValue)
                                        {
                                            <span>@(horario.Puntualidad switch
                                            {
                                                EstadoPuntualidad.Tardio => "Tardío",
                                                EstadoPuntualidad.FueraDePlazo => "Fuera de plazo",
                                                _ => "Puntual"
                                            })</span>
                                            @if (horario.FueraDeRango)
                                            {
                                                <span class="badge text-bg-danger ms-1">Alerta</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-secondary">Sin registro</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (horario.RegistroId.HasValue)
                                        {
                                            <a asp-page="/Registros/Historial/Detalle" asp-route-id="@horario.RegistroId"
                                               class="btn btn-sm btn-outline-secondary">Ver</a>
                                        }
                                        else if (horario.Estado == EstadoHorarioDiario.Pendiente)
                                        {
                                            <a asp-page="/Registros/Nuevo" asp-route-AmbienteId="@resumen.AmbienteId"
                                               class="btn btn-sm btn-primary">Registrar</a>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="card-title">Alertas recientes</h2>
                    <a asp-page="/Registros/Historial/Index"
                       asp-route-FechaDesde="@resumen.FechaOperativa.ToString("yyyy-MM-dd")"
                       asp-route-FechaHasta="@resumen.FechaOperativa.ToString("yyyy-MM-dd")"
                       asp-route-AmbienteId="@resumen.AmbienteId"
                       asp-route-FueraDeRango="true" class="small">Ver historial</a>
                </div>
                @if (resumen.AlertasRecientes.Count == 0)
                {
                    <div class="card-body text-center py-5">
                        <div class="text-success fw-semibold">Sin alertas de rango</div>
                        <div class="text-secondary small mt-1">No hay valores fuera de los límites en este día.</div>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var alerta in resumen.AlertasRecientes)
                        {
                            <a asp-page="/Registros/Historial/Detalle" asp-route-id="@alerta.RegistroId"
                               class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between gap-2">
                                    <div class="fw-semibold">@alerta.Medicion</div>
                                    <span class="badge text-bg-danger">
                                        @(alerta.EstadoRango == EstadoRango.PorDebajo ? "Bajo" : "Alto")
                                    </span>
                                </div>
                                <div class="small mt-1">
                                    @alerta.Valor.ToString("0.##") @alerta.Unidad · rango
                                    @alerta.LimiteMinimo.ToString("0.##")–@alerta.LimiteMaximo.ToString("0.##")
                                </div>
                                <div class="text-secondary small">Horario @alerta.Horario</div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@functions {
    private static string EtiquetaEstado(EstadoHorarioDiario estado) => estado switch
    {
        EstadoHorarioDiario.Completado => "Completado",
        EstadoHorarioDiario.Pendiente => "Pendiente",
        EstadoHorarioDiario.Vencido => "Vencido",
        _ => "Próximo"
    };
}

@section Scripts {
    @if (User.Identity?.IsAuthenticated == true && Model.EsSupervisor && Model.ResumenPeriodo is not null)
    {
        <script src="~/lib/chartjs/chart.umd.js"></script>
        <script src="~/js/avance-dashboard.js" asp-append-version="true"></script>
    }
}
