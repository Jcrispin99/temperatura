@page
@using Temperatura.Web.Domain.Enums
@model Temperatura.Web.Pages.Admin.Incidencias.IndexModel
@{
    ViewData["Title"] = "Incidencias de registro";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Incidencias de registro</h1>
        <p class="text-secondary mb-0">Revisa rondas omitidas y regularizaciones realizadas fuera de plazo.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
{
    <div class="alert alert-success" role="alert">@Model.MensajeExito</div>
}
@if (TempData["MensajeError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3 align-items-end">
            <div class="col-sm-4">
                <label asp-for="FechaDesde" class="form-label">Fecha operativa desde</label>
                <input asp-for="FechaDesde" type="date" class="form-control" />
            </div>
            <div class="col-sm-4">
                <label asp-for="FechaHasta" class="form-label">Fecha operativa hasta</label>
                <input asp-for="FechaHasta" type="date" class="form-control" />
            </div>
            <div class="col-sm-3">
                <label asp-for="Estado" class="form-label">Estado</label>
                <select asp-for="Estado" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var estado in Enum.GetValues<EstadoIncidenciaRegistro>())
                    {
                        <option value="@estado">@IndexModel.ObtenerEtiqueta(estado)</option>
                    }
                </select>
            </div>
            <div class="col-sm-1 d-grid">
                <button type="submit" class="btn btn-primary">Filtrar</button>
            </div>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-header">
        <h2 class="card-title">@Model.Incidencias.Count incidencia(s)</h2>
    </div>
    @if (Model.Incidencias.Count == 0)
    {
        <div class="card-body text-center py-5 text-secondary">
            No hay incidencias con los filtros seleccionados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ronda</th>
                        <th>Incidencia</th>
                        <th>Regularización</th>
                        <th>Revisión</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var incidencia in Model.Incidencias)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@incidencia.Ambiente · @incidencia.Horario</div>
                                <div class="small text-secondary">
                                    Día @incidencia.FechaOperativa.ToString("dd/MM/yyyy") · cierre @incidencia.FechaHoraCierre.ToString("dd/MM HH:mm")
                                </div>
                            </td>
                            <td>
                                <span class="badge @ClaseEstado(incidencia.Estado)">@IndexModel.ObtenerEtiqueta(incidencia.Estado)</span>
                                @if (incidencia.FechaHoraRevision.HasValue)
                                {
                                    <div class="small text-secondary mt-1">
                                        @incidencia.RevisadoPor · @incidencia.FechaHoraRevision.Value.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(incidencia.ComentarioRevision))
                                    {
                                        <div class="small mt-1">@incidencia.ComentarioRevision</div>
                                    }
                                }
                            </td>
                            <td>
                                @if (incidencia.RegistroId.HasValue)
                                {
                                    <div>@incidencia.FechaHoraRegularizacion?.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="small text-secondary">@incidencia.RegistradoPor</div>
                                    <div class="small mt-1"><strong>Motivo:</strong> @incidencia.Motivo</div>
                                    <a asp-page="/Registros/Historial/Detalle" asp-route-id="@incidencia.RegistroId"
                                       class="btn btn-sm btn-outline-secondary mt-2">Ver mediciones</a>
                                }
                                else
                                {
                                    <span class="text-danger">Sin registro</span>
                                }
                            </td>
                            <td style="min-width: 270px">
                                <form method="post" asp-page-handler="CambiarEstado">
                                    <input type="hidden" name="id" value="@incidencia.Id" />
                                    <input asp-for="FechaDesde" type="hidden" />
                                    <input asp-for="FechaHasta" type="hidden" />
                                    <input asp-for="Estado" type="hidden" />
                                    <select name="nuevoEstado" class="form-select form-select-sm mb-2" required>
                                        <option value="">Selecciona una resolución</option>
                                        <option value="@EstadoIncidenciaRegistro.Justificada">Justificar</option>
                                        <option value="@EstadoIncidenciaRegistro.FaltaConfirmada">Confirmar falta</option>
                                        <option value="@EstadoIncidenciaRegistro.AmonestacionEmitida">Marcar amonestación emitida</option>
                                        <option value="@EstadoIncidenciaRegistro.Descartada">Descartar</option>
                                    </select>
                                    <textarea name="comentario" class="form-control form-control-sm mb-2" rows="2"
                                              maxlength="1000" placeholder="Comentario de revisión (opcional)"></textarea>
                                    <button type="submit" class="btn btn-sm btn-primary w-100">Guardar revisión</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    private static string ClaseEstado(EstadoIncidenciaRegistro estado) => estado switch
    {
        EstadoIncidenciaRegistro.PendienteRegistro => "text-bg-danger",
        EstadoIncidenciaRegistro.RegularizadaFueraDePlazo => "text-bg-warning",
        EstadoIncidenciaRegistro.Justificada => "text-bg-info",
        EstadoIncidenciaRegistro.FaltaConfirmada => "text-bg-danger",
        EstadoIncidenciaRegistro.AmonestacionEmitida => "text-bg-dark",
        _ => "text-bg-secondary"
    };
}
