@page
@model Temperatura.Web.Pages.Admin.Horarios.IndexModel
@{
    ViewData["Title"] = "Horarios";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Horarios de toma de muestra</h1>
        <p class="text-secondary mb-0">
            Rondas institucionales: aplican a todos los ambientes por igual.
            Qué ronda le toca a cada ambiente se define en <a asp-page="/Admin/Ambientes/Index">Ambientes</a>.
        </p>
    </div>
    <a asp-page="Crear" class="btn btn-primary">Crear horario</a>
</div>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Hora</th>
                    <th>Nombre</th>
                    <th>Día operativo</th>
                    <th>Ambientes</th>
                    <th>Registros</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var horario in Model.Horarios)
                {
                    <tr>
                        <td class="fw-semibold">@horario.HoraReferencia.ToString("HH\\:mm")</td>
                        <td>@horario.Nombre</td>
                        <td>
                            @if (horario.EsCierreDiaOperativoAnterior)
                            {
                                <span class="badge text-bg-info">Cierra el día anterior</span>
                            }
                            else
                            {
                                <span class="text-secondary">Mismo día</span>
                            }
                        </td>
                        <td>@horario.Ambientes</td>
                        <td>@horario.Registros</td>
                        <td>
                            <span class="badge @(horario.Activo ? "text-bg-success" : "text-bg-secondary")">
                                @(horario.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-page="Editar" asp-route-id="@horario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="alert alert-info mt-3" role="note">
    Los horarios no se eliminan porque los registros históricos los referencian. Para dejar de usar una ronda,
    desactívala aquí o quítala del ambiente correspondiente.
</div>
