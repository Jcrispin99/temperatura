@page
@model Temperatura.Web.Pages.Admin.Usuarios.IndexModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Usuarios</h1>
        <p class="text-secondary mb-0">Administra accesos, roles y ambientes asignados.</p>
    </div>
    <a asp-page="Crear" class="btn btn-primary">Crear usuario</a>
</div>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Ambientes</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@usuario.Nombre</div>
                            <div class="small text-secondary">@usuario.Email</div>
                        </td>
                        <td>@usuario.Rol</td>
                        <td>
                            @if (usuario.Ambientes.Count == 0)
                            {
                                <span class="text-secondary">Todos por rol o sin asignar</span>
                            }
                            else
                            {
                                @string.Join(", ", usuario.Ambientes)
                            }
                        </td>
                        <td>
                            <span class="badge @(usuario.Activo ? "text-bg-success" : "text-bg-secondary")">
                                @(usuario.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-page="Editar" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
