@page
@model Temperatura.Web.Pages.Admin.Ambientes.IndexModel
@{
    ViewData["Title"] = "Ambientes";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Ambientes</h1>
        <p class="text-secondary mb-0">Administra los espacios físicos disponibles.</p>
    </div>
    <a asp-page="Crear" class="btn btn-primary">Crear ambiente</a>
</div>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ambiente</th>
                    <th>Usuarios</th>
                    <th>Mediciones</th>
                    <th>Horarios</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ambiente in Model.Ambientes)
                {
                    <tr>
                        <td class="fw-semibold">@ambiente.Nombre</td>
                        <td>@ambiente.Usuarios</td>
                        <td>@ambiente.Mediciones</td>
                        <td>@ambiente.Horarios</td>
                        <td>
                            <span class="badge @(ambiente.Activo ? "text-bg-success" : "text-bg-secondary")">
                                @(ambiente.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-page="Editar" asp-route-id="@ambiente.Id" class="btn btn-sm btn-outline-primary">Configurar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
