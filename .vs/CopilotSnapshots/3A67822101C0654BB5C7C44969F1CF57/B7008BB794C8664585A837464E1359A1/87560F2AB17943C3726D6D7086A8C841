:root {
  --app-sidebar-width: 17rem;
}

html {
  font-size: 15px;
}

body {
  background: var(--tblr-bg-surface-secondary);
}

.page-wrapper,
.page-body,
.page-body main {
  min-width: 0;
}

.page-wrapper {
  overflow-x: hidden;
}

.app-sidebar {
  --tblr-navbar-border-color: rgba(255, 255, 255, 0.08);
}

.brand-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: inherit;
  text-decoration: none;
}

.brand-symbol {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  color: #fff;
  background: var(--tblr-primary);
  border-radius: 0.75rem;
}

.brand-title,
.brand-subtitle {
  display: block;
  line-height: 1.2;
}

.brand-title {
  font-size: 1rem;
  font-weight: 700;
  color: #fff;
}

.brand-subtitle {
  margin-top: 0.15rem;
  font-size: 0.675rem;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.58);
}

.nav-section-label {
  padding: 0.5rem 1rem;
  color: rgba(255, 255, 255, 0.45);
  font-size: 0.675rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.sidebar-account {
  padding: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar-user-link {
  display: flex;
  align-items: center;
  min-width: 0;
  color: #fff;
  text-decoration: none;
}

.sidebar-user-link:hover {
  color: #fff;
}

.sidebar-user-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 0.75rem;
}

.sidebar-user-name {
  font-size: 0.8rem;
}

.sidebar-user-role {
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.7rem;
}

.measurement-field {
  height: 100%;
  padding: 1rem;
  border: 1px solid var(--tblr-border-color);
  border-radius: var(--tblr-border-radius-lg);
  background: var(--tblr-bg-surface-secondary);
}

.schedule-chip {
  display: inline-flex;
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  background: var(--tblr-primary-lt);
  color: var(--tblr-primary);
  font-weight: 600;
}

.dashboard-percentage {
  color: var(--tblr-primary);
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 1;
}

.dashboard-metric {
  margin: 0.35rem 0;
  color: var(--tblr-body-color);
  font-size: 2rem;
  font-weight: 700;
  line-height: 1.1;
}

.dashboard-environment-selector {
  width: min(100%, 23rem);
}

.schedule-status {
  display: inline-flex;
  align-items: center;
  padding: 0.3rem 0.6rem;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  white-space: nowrap;
}

.schedule-status-completado {
  color: var(--tblr-success);
  background: var(--tblr-success-lt);
}

.schedule-status-pendiente {
  color: var(--tblr-primary);
  background: var(--tblr-primary-lt);
}

.schedule-status-vencido {
  color: var(--tblr-danger);
  background: var(--tblr-danger-lt);
}

.schedule-status-proximo {
  color: var(--tblr-secondary);
  background: var(--tblr-secondary-lt);
}

.table > :not(caption) > * > * {
  padding-top: 0.85rem;
  padding-bottom: 0.85rem;
}

.form-control:focus,
.form-select:focus,
.form-check-input:focus {
  box-shadow: 0 0 0 0.2rem rgba(var(--tblr-primary-rgb), 0.18);
}

@media (min-width: 992px) {
  .app-sidebar {
    width: var(--app-sidebar-width);
  }

  .app-sidebar + .page-wrapper {
    margin-left: var(--app-sidebar-width);
  }
}

@media (max-width: 991.98px) {
  .app-sidebar .navbar-brand {
    flex: 1;
    justify-content: flex-start;
  }

  .sidebar-account {
    margin-top: 1rem !important;
  }
}

.gauge-container {
  position: relative;
  width: 200px;
  height: 120px;
  margin: 0 auto;
}

.gauge-svg {
  width: 100%;
  height: 100%;
}

.gauge-progress {
  transition: stroke-dasharray 0.3s ease;
}

.gauge-value {
  position: absolute;
  top: 70%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 2rem;
  font-weight: 700;
  color: var(--tblr-primary);
}

.dashboard-stat-value {
  font-size: 2.5rem;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 0.5rem;
}

